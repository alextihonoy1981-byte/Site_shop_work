# Публичный HTTPS-адрес сайта, без завершающего слеша
SITE_URL=
# Публичный email для посетителей (не пароль)
CONTACT_EMAIL=
# Реальное имя/наименование оператора данных и контакт для обращений
OWNER_NAME=
OWNER_CONTACT=
# Включить только после утверждения условий /privacy и подключения сервисов
LEAD_INTAKE_ENABLED=false
# Supabase → Project Settings → API: URL проекта и серверный secret/service_role
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Токен от @BotFather; никогда не отправляйте его в чат
TELEGRAM_BOT_TOKEN=
# Числовой идентификатор получателя уведомлений
TELEGRAM_CHAT_ID=
